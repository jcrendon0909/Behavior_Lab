# ============================================
# GITIGNORE - Behavior_Lab
# Stack: Node.js + Mac + Cloudflare Pages + Render
# ============================================

# ---------- Variables de entorno (NUNCA subir) ----------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ---------- Dependencias ----------
node_modules/

# ---------- Build / output ----------
dist/
build/
.next/
out/
.turbo/
.vite/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
server.log

# ---------- Temporales (scripts de dump, pruebas) ----------
dump*.sh
dump*.txt
*.tmp
*.bak

# ---------- Wrangler / Cloudflare ----------
.wrangler/
.dev.vars

# ---------- Render ----------
render.yaml.bak

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------- Testing / Coverage ----------
coverage/
.nyc_output/

# ---------- NOTA: NO ignorar _drafts/ ----------
# Cloudflare Pages ignora automáticamente carpetas con prefijo "_"
# pero Git SÍ debe trackearlas para no perder los borradores.
